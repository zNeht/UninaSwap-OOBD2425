@startuml
'https://plantuml.com/class-diagram

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 12
hide circle

package "App" as APP {
  class Launcher {
    +main(args)
  }
  class MainApp {
    +start(stage)
  }
}

package "Auth/Session" as AUTH {
  class Session {
    -matricola
    +getMatricola()
    +setMatricola(matricola)
    +clear()
  }
  class loginController {
    +initialize()
    +handleLogin()
    +onRegisterLinkClick()
  }
  class registerController {
    +initialize()
    +handleRegister()
    +onLoginLinkClick()
  }
}

package "UI Controllers" as UI {
  class homepageController {
    +initialize()
    +handleNuovoAnnuncio()
    +loadAnnunci(...)
    +chiudiPopup()
  }
  class annuncioCardController {
    +setData(annuncio, wishlisted, wishlistCount, removeOnUnfavorite)
  }
  class dettaglioAnnuncioController {
    +setAnnuncio(annuncio)
    +setAnnuncioWithOffer(annuncio, offerta)
    +setOnClose(Runnable)
  }
  class nuovoAnnuncioController {
    +handlePubblicaAnnuncio()
    +handleAnnulla()
    +getSelectedImages()
  }
  class offerteController {
    +loadData()
    +handleAccetta(offerta)
    +handleRifiuta(offerta)
    +handleRitira(offerta)
  }
  class offerRegaloController {
    +init(annuncio)
    +handleInvia()
  }
  class offerScambioController {
    +init(annuncio)
    +handleAdd()
    +handleInvia()
  }
  class offerVenditaController {
    +init(annuncio)
    +handleAccetta()
    +handleInvia()
  }
  class offertaCardController {
    +setData(offerta)
    +setActionStates(canModify, canWithdraw)
    +setHandlers(onModifica, onRitira)
    +showReviewButton(show)
    +showModifyWithdraw(show)
    +showItemsButton(show)
    +showMessageButton(show)
    +showEditMessageButton(show)
    +setOnOpenDetails(handler)
    +setOnRecensisci(handler)
  }
  class offerPaneController {
    +init(annuncio)
  }
  class recensioniController {
    +loadData()
  }
  class recensioneCardController {
    +setData(recensione, ricevuta)
  }
  class statisticheController {
    +loadData()
  }
}

package "DAO" as DAO {
  class DB {
    +getConnection()
  }
  class annuncioDAO {
    +getAnnunciAttiviConImgPrincipaleByTipo(tipo)
    +getAnnunciAttiviConImgPrincipaleByTipoAndCategoria(tipo, categoria)
    +getAnnunciPreferitiByUtente(matricola)
    +getAnnunciPreferitiByUtenteAndCategoria(matricola, categoria)
    +getAnnuncioById(idAnnuncio)
    +insertAnnuncioReturningId(...)
  }
  class immagineAnnuncioDAO {
    +insertImages(idAnnuncio, imgs)
    +getImagesByAnnuncio(idAnnuncio)
  }
  class offertaDAO {
    +getOfferteRicevute(matricolaVenditore)
    +getOfferteInviate(matricolaOfferente)
    +aggiornaStato(idOfferta, stato)
    +rifiutaAltreOfferteInAttesa(idAnnuncio, idOffertaAccettata)
    +creaOffertaScambio(idAnnuncio, matricola, messaggio)
    +aggiornaImportoEMessaggioEStato(idOfferta, importo, messaggio, stato)
  }
  class wishlistDAO {
    +add(idAnnuncio, idUtente)
    +remove(idAnnuncio, idUtente)
    +exists(idAnnuncio, idUtente)
    +countForAnnuncio(idAnnuncio)
  }
  class recensioniDAO {
    +getRicevute(matricola)
    +getInviate(matricola)
  }
  class recensioneDAO {
    +deleteByOffertaAndRecensore(idOfferta, matricolaRecensore)
    +inserisci(idOfferta, matricolaRecensore, matricolaRecensito, voto, commento)
    +existsByOffertaAndRecensore(idOfferta, matricolaRecensore)
  }
  class oggettoScambioDAO {
    +getByOfferta(idOfferta)
    +insert(idOfferta, nome, path)
    +deleteByOfferta(idOfferta)
  }
  class statisticheDAO {
    +getStatistiche(matricola)
  }
}

package "Model" as MODEL {
  class annuncio
  class offerta
  class recensione
  class oggettoScambio
  class transazione
  class utente
  class immagineAnnuncio
  class wishlist
}

package "Util" as UTIL {
  class ImageHandler {
    +saveImages(idAnnuncio, files)
    +resolveToAbsolute(dbPath)
  }
  class ScambioImageHandler {
    +saveImage(idOfferta, sourcePath, ordine)
  }
}

APP -[hidden]- AUTH
AUTH -[hidden]- UI
UI -[hidden]- DAO
DAO -[hidden]- MODEL
MODEL -[hidden]- UTIL

Launcher --> MainApp
MainApp --> loginController

loginController --> Session
registerController --> Session
loginController --> DB
registerController --> DB

homepageController --> annuncioDAO
homepageController --> wishlistDAO
homepageController --> Session
homepageController --> dettaglioAnnuncioController

annuncioCardController --> annuncio
annuncioCardController --> ImageHandler

dettaglioAnnuncioController --> annuncio
dettaglioAnnuncioController --> immagineAnnuncioDAO
dettaglioAnnuncioController --> offerPaneController

nuovoAnnuncioController --> annuncioDAO
nuovoAnnuncioController --> immagineAnnuncioDAO
nuovoAnnuncioController --> ImageHandler
nuovoAnnuncioController --> Session

offerteController --> offertaDAO
offertaCardController --> offerta
offerPaneController --> offertaDAO
offerPaneController --> ScambioImageHandler
offerRegaloController ..|> offerPaneController
offerScambioController ..|> offerPaneController
offerVenditaController ..|> offerPaneController

recensioniController --> recensioniDAO
recensioneCardController --> recensione

statisticheController --> statisticheDAO

annuncioDAO --> DB
immagineAnnuncioDAO --> DB
offertaDAO --> DB
wishlistDAO --> DB
recensioniDAO --> DB
oggettoScambioDAO --> DB
statisticheDAO --> DB
@enduml
