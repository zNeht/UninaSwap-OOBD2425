--
-- TOC entry 229 (class 1259 OID 57704)
-- Name: report_offerte; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.report_offerte AS
 SELECT a.tipo AS tipo_annuncio,
    count(*) AS totale_offerte,
    count(*) FILTER (WHERE (o.stato = 'accettata'::public.stato_offerta_enum)) AS offerte_accettate,
    avg(o.importo_proposto) FILTER (WHERE ((o.stato = 'accettata'::public.stato_offerta_enum) AND (a.tipo = 'vendita'::public.tipo_annuncio_enum))) AS media,
    min(o.importo_proposto) FILTER (WHERE ((o.stato = 'accettata'::public.stato_offerta_enum) AND (a.tipo = 'vendita'::public.tipo_annuncio_enum))) AS minimo,
    max(o.importo_proposto) FILTER (WHERE ((o.stato = 'accettata'::public.stato_offerta_enum) AND (a.tipo = 'vendita'::public.tipo_annuncio_enum))) AS massimo
   FROM (public.offerta o
     JOIN public.annuncio a ON ((o.id_annuncio = a.id_annuncio)))
  GROUP BY a.tipo;


ALTER VIEW public.report_offerte OWNER TO postgres;

